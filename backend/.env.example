# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# ── Debug ─────────────────────────────────────────────────────────────────────
DEBUG=True

# ── Allowed hosts (comma-separated) ──────────────────────────────────────────
ALLOWED_HOSTS=127.0.0.1,localhost

# ── CORS (comma-separated origins) ───────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Database (SQLite3 default — switch to Neon PostgreSQL in prod) ────────────
DATABASE_URL=
DJANGO_ENV=development
ALLOW_SQLITE_FALLBACK=true


# ── File upload staging directory ────────────────────────────────────────────
# Temporary files are written here during conversion and deleted after processing.
TEMP_UPLOAD_DIR=../tmp_uploads

# ── Max upload size in bytes (default: 50 MB) ────────────────────────────────
MAX_UPLOAD_SIZE=52428800
