# ── VELTO Conversion — Backend Environment Variables ─────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# ── Debug ─────────────────────────────────────────────────────────────────────
# Set to False in production
DEBUG=True

# ── Allowed hosts (comma-separated) ──────────────────────────────────────────
ALLOWED_HOSTS=127.0.0.1,localhost

# ── CORS (comma-separated origins) ───────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ── CSRF ─────────────────────────────────────────────────────────────────────
CSRF_TRUSTED_ORIGINS=

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL / Neon production URL (leave empty to use SQLite fallback for dev)
DATABASE_URL=postgresql://neondb_owner:npg_wuWkCFpO7J0S@ep-cold-mode-azi0049f-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DJANGO_ENV=development
# Set to false in production to enforce PostgreSQL requirement
ALLOW_SQLITE_FALLBACK=true

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=False
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=240

# ── Storage ───────────────────────────────────────────────────────────────────
# "local" for development, "s3" for production
STORAGE_BACKEND=local

# S3 / Object Storage (required when STORAGE_BACKEND=s3)
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PRESIGNED_UPLOAD_EXPIRY=900
S3_PRESIGNED_DOWNLOAD_EXPIRY=900

# ── File upload ───────────────────────────────────────────────────────────────
TEMP_UPLOAD_DIR=../tmp_uploads
MAX_UPLOAD_SIZE=52428800

# ── Storage quotas / retention ────────────────────────────────────────────────
# Per-owner storage quota in bytes (default: 500 MB)
STORAGE_QUOTA_BYTES=524288000
# Retention hours for completed output files (default: 24 hours)
STORAGE_RETENTION_HOURS=24

# ── Observability ─────────────────────────────────────────────────────────────
# Sentry DSN (leave empty to disable)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=velto-conversion@1.0.0
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Set to "production" for JSON structured logging
ENVIRONMENT=development

# ── Internal metrics token ────────────────────────────────────────────────────
METRICS_TOKEN=
